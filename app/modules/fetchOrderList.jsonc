/**
 * MODULE: fetchOrderList
 * TYPE: Search (returns order list)
 * PROXY FUNCTION: fetchOrderList
 * DOWNSTREAM: RTDD POST …/pgrtdd/dataservice/bizorder/search.htm
 *   function = pgrtdd.dataservice.bizorder.search
 *
 * RTDD contract (BizOrderSearchRequest): nest business fields under params.body so proxy builds
 *   {"request":{"head":{…},"body":{…}},"signature":"…"}.
 *
 * Mandatory / core body fields (ma-facade BizOrderSearchRequestBody + test sample):
 *   - searchConditions[] — searchKey=MERCHANT_ID, searchValue=MID (required)
 *   - orderCreatedStartTime / orderCreatedEndTime — YYYY-MM-DDTHH:mm:ss+05:30
 * Optional later: orderStatuses[], bizOrderTypes[] (enums — not passbook "ALL"/pipe strings)
 *
 * Do NOT send passbook fields here: mid, fromDate, toDate, orderSearchStatus, pageNumber.
 * Zapier "Fetch All Orders" uses merchant-passbook; this module hits RTDD bizorder.search.
 *
 * RESPONSE: body.data.response.body.orders
 */
{
    "url": "{{connection.baseUrl}}/integration/fetchOrderList?mid={{connection.merchantId}}",
    "method": "POST",
    "headers": {
        "X-Signature": "{{sha256(connection.merchantId; 'hex'; connection.keySecret; 'utf8')}}"
    },
    "body": {
        "requestId": "{{formatDate(now; 'X')}}000",
        "timestamp": "{{formatDate(now; 'X')}}000",
        "params": {
            "body": {
                "searchConditions": [
                    {
                        "searchKey": "MERCHANT_ID",
                        "searchValue": "{{connection.merchantId}}"
                    }
                ],
                "orderCreatedStartTime": "{{formatDate(parameters.startDate; 'YYYY-MM-DD')}}T00:00:00+05:30",
                "orderCreatedEndTime": "{{formatDate(parameters.endDate; 'YYYY-MM-DD')}}T23:59:59+05:30"
            }
        }
    },
    "response": {
        "iterate": "{{body.data.response.body.orders}}",
        "output": "{{item}}"
    }
}
