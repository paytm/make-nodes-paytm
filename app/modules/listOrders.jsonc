/**
 * MODULE: listOrders
 * RESOURCE: Payments
 * DESCRIPTION: Retrieves a paginated list of merchant orders / transactions
 *              within a date range, with optional status and type filters.
 *
 * PAYTM API ENDPOINT
 *   Method : POST
 *   Path   : /merchant-passbook/search/list/order/v2
 *   Docs   : https://developer.paytm.com/docs/merchant-passbook/list-orders/
 *
 * N8N PARITY
 *   Operation : payments > listOrders  (n8n-nodes-paytm v1.6.1)
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * CHECKSUM ALGORITHM (Paytm standard — same for all non-RTDD modules)
 *
 *   1. Collect all body parameters that are part of the signed payload.
 *   2. Sort their KEYS alphabetically.
 *   3. Concatenate their VALUES in sorted-key order, each value suffixed with "|".
 *   4. Append the merchant's keySecret followed by "|".
 *   5. SHA-256 hash the resulting string and Base64-encode the digest.
 *
 *   Reference implementation:
 *     github.com/Paytm-Payments/paytm-pg-php-sdk  /  lib/utils/PaytmChecksum.js
 *
 * SIGNING STRING FOR THIS ENDPOINT (keys in alphabetical order)
 *   fromDate | isSort | mid | orderSearchStatus | orderSearchType |
 *   pageNumber | pageSize | toDate | <keySecret>
 *
 *   Resulting string template:
 *     "<fromDate>|<isSort>|<mid>|<orderSearchStatus>|<orderSearchType>|<pageNumber>|<pageSize>|<toDate>|<keySecret>"
 *
 * ─────────────────────────────────────────────────────────────────────────────
 * WHY THE `temp` BLOCK EXISTS
 *
 *   Make's IML parser cannot handle more than ~3 nested function calls
 *   (formatDate(), ifempty(), toString()) concatenated inside a single
 *   sha256() expression. Attempting to do so throws:
 *     "Unexpected end of string"
 *
 *   The `temp` block is Make's built-in mechanism for precomputing values
 *   before the `body` / `headers` / `url` blocks are evaluated.
 *   Each temp entry formats its value AND appends the trailing "|" separator
 *   so that the sha256() call only joins simple property references —
 *   no nested function calls, no parser limit reached.
 *
 * TEMP VARIABLE NAMING CONVENTION
 *   sd   → fromDate  (start date)
 *   ed   → toDate    (end date)
 *   st   → orderSearchStatus
 *   tp   → orderSearchType
 *   pn   → pageNumber
 *   ps   → pageSize
 *   mid  → mid (merchant ID)
 *   isSort → isSort (hardcoded true, always signed)
 */
{
    // ── Precomputed signing fragments ────────────────────────────────────────
    // Each value is the final string that goes into the checksum signing string
    // for this field (formatted value + "|" separator).
    // Order here does NOT matter — sha256() call below assembles alphabetically.
    "temp": {
        // fromDate: formatted as YYYY-MM-DD + pipe
        "sd": "{{formatDate(parameters.startDate; 'YYYY-MM-DD') + '|'}}",

        // toDate: formatted as YYYY-MM-DD + pipe
        "ed": "{{formatDate(parameters.endDate; 'YYYY-MM-DD') + '|'}}",

        // orderSearchStatus: defaults to 'ALL' if not provided + pipe
        "st": "{{ifempty(parameters.orderSearchStatus; 'ALL') + '|'}}",

        // orderSearchType: defaults to 'TRANSACTION' if not provided + pipe
        "tp": "{{ifempty(parameters.orderSearchType; 'TRANSACTION') + '|'}}",

        // pageNumber: coerced to string (sha256 input must be string) + pipe
        "pn": "{{toString(ifempty(parameters.pageNumber; 1)) + '|'}}",

        // pageSize: coerced to string + pipe
        "ps": "{{toString(ifempty(parameters.pageSize; 10)) + '|'}}",

        // mid: merchant ID from connection credentials + pipe
        "mid": "{{connection.merchantId + '|'}}",

        // isSort: always 'true' (this endpoint requires sort=true) + pipe
        "isSort": "true|"
    },

    // ── Request ──────────────────────────────────────────────────────────────
    "url": "{{connection.baseUrl}}/merchant-passbook/search/list/order/v2",
    "method": "POST",
    "headers": {
        "Content-Type": "application/json"
    },

    // Body parameters mirror the Paytm API contract exactly.
    // `paytmChecksum` is injected here — Paytm validates it server-side.
    "body": {
        "mid": "{{connection.merchantId}}",
        "fromDate": "{{formatDate(parameters.startDate; 'YYYY-MM-DD')}}",
        "toDate": "{{formatDate(parameters.endDate; 'YYYY-MM-DD')}}",
        "orderSearchStatus": "{{ifempty(parameters.orderSearchStatus; 'ALL')}}",
        "orderSearchType": "{{ifempty(parameters.orderSearchType; 'TRANSACTION')}}",
        "pageNumber": "{{ifempty(parameters.pageNumber; 1)}}",
        "pageSize": "{{ifempty(parameters.pageSize; 10)}}",
        "isSort": true,

        // Checksum — assembled from temp fragments in ALPHABETICAL KEY ORDER:
        // fromDate | isSort | mid | orderSearchStatus | orderSearchType | pageNumber | pageSize | toDate | keySecret
        //   sd        isSort  mid    st                  tp                pn           ps         ed       (appended raw)
        "paytmChecksum": "{{sha256(temp.sd + temp.isSort + temp.mid + temp.st + temp.tp + temp.pn + temp.ps + temp.ed + connection.keySecret; 'base64')}}"
    },

    // ── Response ─────────────────────────────────────────────────────────────
    // Pass through the full response body. The module Interface tab defines
    // which fields Make exposes as mappable outputs.
    "response": {
        "output": "{{body}}"
    }
}
