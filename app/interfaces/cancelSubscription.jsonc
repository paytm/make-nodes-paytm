        "spec": [
            { "name": "responseTimestamp", "label": "Response timestamp", "type": "text" },
            { "name": "signature",         "label": "Signature",          "type": "text" }
        ]
    },
    {
        "name": "body",
        "label": "Response body",
        "type": "collection",
        "spec": [
            {
                "name": "resultInfo",
                "label": "Result info",
