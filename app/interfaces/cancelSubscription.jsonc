                "spec": [
                    { "name": "resultStatus", "label": "Result status", "type": "text" },
                    { "name": "resultCode",   "label": "Result code",   "type": "text" },
                    { "name": "resultMsg",    "label": "Result message", "type": "text" }
                ]
            },
            { "name": "subsId", "label": "Subscription ID", "type": "text" },
            { "name": "status", "label": "Status",          "type": "text" }
        ]
    }
]
