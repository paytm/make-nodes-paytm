/**
 * INTERFACE: fetchSubscriptionStatus
 * OUTPUT: body.data — the full Paytm /subscription/subscription/checkStatus response
 *
 * Paste this into: Apps Editor → fetchSubscriptionStatus → Interface tab
 * Strip JSONC comments first.
 *
 * NOTE: Verify field names against a real Paytm subscription checkStatus response.
 */
[
    {
        "name": "head",
        "label": "Response head",
        "type": "collection",
        "spec": [
            { "name": "responseTimestamp", "label": "Response timestamp", "type": "text" },
            { "name": "signature",         "label": "Signature",          "type": "text" }
        ]
    },
    {
        "name": "body",
        "label": "Response body",
        "type": "collection",
        "spec": [
            {
                "name": "resultInfo",
                "label": "Result info",
                "type": "collection",
                "spec": [
                    { "name": "resultStatus", "label": "Result status", "type": "text" },
                    { "name": "resultCode",   "label": "Result code",   "type": "text" },
                    { "name": "resultMsg",    "label": "Result message", "type": "text" }
                ]
            },
            { "name": "subsId",    "label": "Subscription ID",  "type": "text" },
            { "name": "orderId",   "label": "Order ID",         "type": "text" },
            { "name": "linkId",    "label": "Link ID",          "type": "text" },
            { "name": "custId",    "label": "Customer ID",      "type": "text" },
            { "name": "status",    "label": "Status",           "type": "text" },
            { "name": "amount",    "label": "Amount",           "type": "text" },
            { "name": "frequency", "label": "Frequency",        "type": "text" },
            { "name": "startDate", "label": "Start date",       "type": "date" },
            { "name": "endDate",   "label": "End date",         "type": "date" },
            { "name": "custMobile","label": "Customer mobile",  "type": "phone" },
            { "name": "custEmail", "label": "Customer email",   "type": "email" }
        ]
    }
]
