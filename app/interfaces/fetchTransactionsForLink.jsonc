/**
 * INTERFACE: fetchTransactionsForLink
 * OUTPUT: one item from body.data.txnDetailsList (the iterate path)
 *
 * Paste this into: Apps Editor → fetchTransactionsForLink → Interface tab
 * Strip JSONC comments first.
 *
 * NOTE: Field names must be verified against a real Paytm /link/fetchTransaction response.
 */
[
    { "name": "txnId",        "label": "Transaction ID",      "type": "text"   },
    { "name": "orderId",      "label": "Order ID",            "type": "text"   },
    { "name": "amount",       "label": "Amount",              "type": "text"   },
    { "name": "txnStatus",    "label": "Status",              "type": "text"   },
    { "name": "paymentMode",  "label": "Payment mode",        "type": "text"   },
    { "name": "txnDate",      "label": "Transaction date",    "type": "date"   },
    { "name": "bankName",     "label": "Bank name",           "type": "text"   },
    { "name": "bankTxnId",    "label": "Bank transaction ID", "type": "text"   },
    { "name": "refundAmount", "label": "Refund amount",       "type": "text"   },
    { "name": "custEmail",    "label": "Customer email",      "type": "email"  },
    { "name": "custMobile",   "label": "Customer mobile",     "type": "phone"  }
]
