/**
 * INTERFACE: fetchPaymentLinks
 * OUTPUT: full response bundle from /link/fetch
 *
 * Paste into: Apps Editor → fetchPaymentLinks → Interface tab (strip JSONC comments first)
 * Field names verified against Zapier parity.
 */
[
    {
        "name": "resultInfo",
        "type": "collection",
        "label": "Result Info",
        "spec": [
            { "name": "resultStatus", "type": "text", "label": "Result Status"  },
            { "name": "resultCode",   "type": "text", "label": "Result Code"    },
            { "name": "resultMsg",    "type": "text", "label": "Result Message" }
        ]
    },
    {
        "name": "links",
        "type": "array",
        "label": "Payment Links",
        "spec": [
            { "name": "linkId",            "type": "text",    "label": "Link ID"             },
            { "name": "merchantRequestId", "type": "text",    "label": "Merchant Request ID" },
            { "name": "linkName",          "type": "text",    "label": "Link Name"           },
            { "name": "linkType",          "type": "text",    "label": "Link Type"           },
            { "name": "amount",            "type": "text",    "label": "Amount"              },
            { "name": "paymentStatus",     "type": "text",    "label": "Payment Status"      },
            { "name": "linkUrl",           "type": "url",     "label": "Payment URL"         },
            { "name": "updatedAt",         "type": "date",    "label": "Updated At"          },
            { "name": "isActive",          "type": "boolean", "label": "Is Active"           },
            { "name": "custName",          "type": "text",    "label": "Customer Name"       },
            { "name": "custEmail",         "type": "email",   "label": "Customer Email"      },
            { "name": "custMobile",        "type": "phone",   "label": "Customer Mobile"     }
        ]
    }
]
